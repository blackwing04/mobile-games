              "partial":          { "next": "scene_phone_again", "effects": [{ "resource": "san", "delta": -10 }] },
              "failure":          { "next": "scene_phone_again", "effects": [{ "resource": "san", "delta": -8 }] },
              "fumble":           { "next": "scene_phone_again", "effects": [{ "resource": "san", "delta": -20 }] }
            }
